diff --git a/src/xrCore/xrHitchStats.cpp b/src/xrCore/xrHitchStats.cpp
new file mode 100644
index 00000000..9ba97541
--- /dev/null
+++ b/src/xrCore/xrHitchStats.cpp
@@ -0,0 +1,105 @@
+#include "stdafx.h"
+#include "xrHitchStats.h"
+
+#include <mutex>
+
+namespace xrHitch
+{
+	XRCORE_API int g_log_ms = 100;
+
+	namespace
+	{
+		struct Item
+		{
+			string128 name;
+			float ms;
+		};
+
+		struct Category
+		{
+			const char* id = nullptr;
+			float total = 0.f;
+			u32 count = 0;
+			Item top[4] = {};
+			u32 top_n = 0;
+		};
+
+		std::mutex g_lock;
+		Category g_cats[24];
+		u32 g_cats_n = 0;
+
+		Category* find(const char* id)
+		{
+			for (u32 i = 0; i < g_cats_n; ++i)
+				if (g_cats[i].id == id || 0 == xr_strcmp(g_cats[i].id, id))
+					return &g_cats[i];
+			if (g_cats_n >= 24)
+				return nullptr;
+			Category& c = g_cats[g_cats_n++];
+			c = Category();
+			c.id = id;
+			return &c;
+		}
+	}
+
+	void Add(const char* category, const char* name, float ms)
+	{
+		if (g_log_ms <= 0 || ms < 0.05f)
+			return;
+		std::lock_guard<std::mutex> guard(g_lock);
+		Category* c = find(category);
+		if (!c)
+			return;
+		c->total += ms;
+		c->count++;
+		if (!name || !name[0] || ms < 1.f)
+			return;
+		// keep the 4 slowest items of the category
+		u32 slot = c->top_n;
+		if (c->top_n < 4)
+			c->top_n++;
+		else
+		{
+			slot = 0;
+			for (u32 i = 1; i < 4; ++i)
+				if (c->top[i].ms < c->top[slot].ms)
+					slot = i;
+			if (c->top[slot].ms >= ms)
+				return;
+		}
+		xr_strcpy(c->top[slot].name, name);
+		c->top[slot].ms = ms;
+	}
+
+	void FrameEnd(float frame_ms)
+	{
+		if (g_log_ms <= 0)
+			return;
+		std::lock_guard<std::mutex> guard(g_lock);
+		if (frame_ms >= float(g_log_ms) && g_cats_n)
+		{
+			string4096 line;
+			xr_sprintf(line, "[hitch] %.0f ms:", frame_ms);
+			for (u32 i = 0; i < g_cats_n; ++i)
+			{
+				const Category& c = g_cats[i];
+				if (c.total < 1.f)
+					continue;
+				string512 part;
+				xr_sprintf(part, " | %s %.0f ms x%u", c.id, c.total, c.count);
+				xr_strcat(line, part);
+				for (u32 k = 0; k < c.top_n; ++k)
+				{
+					string256 it;
+					xr_sprintf(it, "%s%s %.0f", k == 0 ? " (" : ", ", c.top[k].name, c.top[k].ms);
+					if (xr_strlen(line) + xr_strlen(it) + 8 < sizeof(line))
+						xr_strcat(line, it);
+				}
+				if (c.top_n)
+					xr_strcat(line, ")");
+			}
+			Msg("%s", line);
+		}
+		g_cats_n = 0;
+	}
+}
diff --git a/src/xrCore/xrHitchStats.h b/src/xrCore/xrHitchStats.h
new file mode 100644
index 00000000..c25d49e3
--- /dev/null
+++ b/src/xrCore/xrHitchStats.h
@@ -0,0 +1,32 @@
+#pragma once
+// Hitch reporter: when a frame takes longer than ixr_hitch_log (ms), the log gets one line
+// with the time spent in the frame stages and in resource loading (textures, models, spawns...).
+// Cheap when off (ixr_hitch_log 0): every probe is a single integer test.
+
+namespace xrHitch
+{
+	extern XRCORE_API int g_log_ms;
+
+	XRCORE_API void Add(const char* category, const char* name, float ms);
+	XRCORE_API void FrameEnd(float frame_ms);
+
+	struct Scope
+	{
+		const char* category;
+		const char* name;
+		u64 start;
+		Scope(const char* c, const char* n) : category(c), name(n), start(0)
+		{
+			if (g_log_ms > 0)
+				start = u64(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+		}
+		~Scope()
+		{
+			if (g_log_ms > 0 && start)
+			{
+				u64 now = u64(std::chrono::duration_cast<std::chrono::microseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+				Add(category, name, float(double(now - start) / 1000.0));
+			}
+		}
+	};
+}
