diff --git a/src/Layers/xrRenderDX10/dx11SH_Texture.cpp b/src/Layers/xrRenderDX10/dx11SH_Texture.cpp
index e2e16c87..f88d9d2d 100644
--- a/src/Layers/xrRenderDX10/dx11SH_Texture.cpp
+++ b/src/Layers/xrRenderDX10/dx11SH_Texture.cpp
@@ -13,6 +13,218 @@
 #include "../xrRender/dxRenderDeviceRender.h"
 
 #include "StateManager/dx10ShaderResourceStateCache.h"
+#include "../../xrEngine/IGame_Level.h"
+
+#include <mutex>
+#include <condition_variable>
+#include <deque>
+#include <thread>
+
+//////////////////////////////////////////////////////////////////////
+// Background texture loading (IX-Ray CS build)
+//////////////////////////////////////////////////////////////////////
+namespace
+{
+	struct ZwTexQueue
+	{
+		std::mutex					lock;
+		std::condition_variable		cv;
+		std::deque<CTexture*>		items;
+		bool						started = false;
+	};
+
+	ZwTexQueue& zw_tex_queue()
+	{
+		static ZwTexQueue* q = new ZwTexQueue();	// never destroyed: worker threads may outlive static destruction
+		return *q;
+	}
+
+	void zw_tex_worker()
+	{
+		Platform::SetThreadName("X-Ray Texture Streaming");
+		ZwTexQueue& q = zw_tex_queue();
+		for (;;)
+		{
+			CTexture* T = nullptr;
+			{
+				std::unique_lock<std::mutex> guard(q.lock);
+				q.cv.wait(guard, [&q]() { return !q.items.empty(); });
+				T = q.items.front();
+				q.items.pop_front();
+				int expected = 1;
+				if (!T->m_async.compare_exchange_strong(expected, 2))
+					T = nullptr;		// taken over by the main thread
+			}
+			if (T)
+			{
+				T->AsyncWork();
+				T->m_async.store(3);
+			}
+		}
+	}
+
+	void zw_tex_enqueue(CTexture* T)
+	{
+		ZwTexQueue& q = zw_tex_queue();
+		{
+			std::lock_guard<std::mutex> guard(q.lock);
+			if (!q.started)
+			{
+				q.started = true;
+				for (int i = 0; i < 2; ++i)
+					std::thread(zw_tex_worker).detach();
+			}
+			q.items.push_back(T);
+		}
+		q.cv.notify_one();
+	}
+
+	// returns true when the caller now owns the job (it was still waiting in the queue)
+	bool zw_tex_claim(CTexture* T)
+	{
+		ZwTexQueue& q = zw_tex_queue();
+		std::lock_guard<std::mutex> guard(q.lock);
+		int expected = 1;
+		if (!T->m_async.compare_exchange_strong(expected, 2))
+			return false;
+		for (auto it = q.items.begin(); it != q.items.end(); ++it)
+		{
+			if (*it == T)
+			{
+				q.items.erase(it);
+				break;
+			}
+		}
+		return true;
+	}
+
+	ID3DShaderResourceView* zw_make_placeholder(u32 rgba)
+	{
+		D3D11_TEXTURE2D_DESC d = {};
+		d.Width = 1;
+		d.Height = 1;
+		d.MipLevels = 1;
+		d.ArraySize = 1;
+		d.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+		d.SampleDesc.Count = 1;
+		d.Usage = D3D11_USAGE_IMMUTABLE;
+		d.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+		D3D11_SUBRESOURCE_DATA init = {};
+		init.pSysMem = &rgba;
+		init.SysMemPitch = 4;
+		init.SysMemSlicePitch = 4;
+		ID3D11Texture2D* tex = nullptr;
+		ID3DShaderResourceView* srv = nullptr;
+		if (SUCCEEDED(RDevice->CreateTexture2D(&d, &init, &tex)) && tex)
+		{
+			RDevice->CreateShaderResourceView(tex, nullptr, &srv);
+			tex->Release();
+		}
+		return srv;
+	}
+
+	// neutral stand-ins while a texture is loading: grey invisible colour, flat bump
+	ID3DShaderResourceView* zw_placeholder(LPCSTR name)
+	{
+		static ID3DShaderResourceView* diffuse = zw_make_placeholder(0x006E6E6Eu);	// rgb 110, alpha 0
+		static ID3DShaderResourceView* bump = zw_make_placeholder(0x8080FF40u);		// gloss .25, normal (0,0,1)
+		static ID3DShaderResourceView* bumpx = zw_make_placeholder(0x80808080u);
+		size_t len = name ? xr_strlen(name) : 0;
+		if (len > 6 && 0 == _stricmp(name + len - 6, "_bump#"))
+			return bumpx;
+		if (len > 5 && 0 == _stricmp(name + len - 5, "_bump"))
+			return bump;
+		return diffuse;
+	}
+}
+
+bool CTexture::LoadAsync()
+{
+	if (!ps_r__common_flags.test(RFLAG_ASYNC_TEX_LOAD))
+		return false;
+	if (!Device.b_is_Ready || pSurface || m_async.load() != 0)
+		return false;
+	if (!g_pGameLevel || !g_pGameLevel->bReady)
+		return false;		// menus and level loading keep the usual path
+
+	LPCSTR n = *cName;
+	if (!n || !n[0] || n[0] == '$' || strstr(n, "$user$"))
+		return false;
+	static const char* prefixes[] = { "ui\\", "ui_", "intro", "fonts", "shaders\\", "lights\\", "levels\\", "terrain\\", "ed\\" };
+	for (const char* p : prefixes)
+		if (n == strstr(n, p))
+			return false;
+	if (strstr(n, "sky") || strstr(n, "lut") || strstr(n, "$rt"))
+		return false;
+
+	string_path fn;
+	if (FS.exist(fn, "$game_textures$", n, ".ogm") || FS.exist(fn, "$game_textures$", n, ".avi") || FS.exist(fn, "$game_textures$", n, ".seq"))
+		return false;
+
+	Preload();
+	flags.bLoaded = true;
+	flags.bUser = false;
+	flags.MemoryUsage = 0;
+	desc_cache = 0;
+	m_async.store(1);
+	bind = xr_make_delegate(this, &CTexture::apply_async);
+	zw_tex_enqueue(this);
+	return true;
+}
+
+void CTexture::AsyncWork()
+{
+	u32 mem = 0;
+	ID3DBaseTexture* surf = ::RImplementation.texture_load(*cName, mem, false);
+	ID3DShaderResourceView* srv = nullptr;
+	if (surf && FAILED(RDevice->CreateShaderResourceView(surf, nullptr, &srv)))
+		srv = nullptr;
+	m_asyncSurface = surf;
+	m_asyncSRV = srv;
+	m_asyncMem = mem;
+}
+
+void CTexture::AsyncPublish()
+{
+	int expected = 3;
+	if (!m_async.compare_exchange_strong(expected, 0))
+		return;
+	pSurface = m_asyncSurface;
+	m_pSRView = m_asyncSRV;
+	m_asyncSurface = nullptr;
+	m_asyncSRV = nullptr;
+	flags.MemoryUsage = m_asyncMem;
+	desc_cache = 0;
+	PostLoad();
+}
+
+void CTexture::AsyncWait()
+{
+	int s = m_async.load();
+	if (s == 0)
+		return;
+	if (s == 1 && zw_tex_claim(this))
+	{
+		xrHitch::Scope zw_scope("tex_wait", *cName);
+		AsyncWork();
+		m_async.store(3);
+	}
+	while (m_async.load() == 2)
+		std::this_thread::yield();
+	AsyncPublish();
+}
+
+void CTexture::apply_async(u32 dwStage)
+{
+	if (m_async.load() == 3)
+		AsyncPublish();
+	if (m_async.load() == 0)
+	{
+		bind(dwStage);
+		return;
+	}
+	ApplyView(dwStage, zw_placeholder(*cName));
+}
 
